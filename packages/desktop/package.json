{
  "name": "@xsb/desktop",
  "version": "0.1.0",
  "description": "The xsb desktop app: an ACP client of the hub with one window per workspace",
  "type": "module",
  "private": true,
  "main": "dist/app/main.js",
  "dependencies": {
    "@xsb/hub": "0.1.0",
    "@xsb/protocol": "0.1.0",
    "dompurify": "^3.4.18",
    "marked": "^18.2.0"
  },
  "devDependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.107.0",
    "@agentclientprotocol/codex-acp": "^2.6.0",
    "electron": "43.8.1",
    "electron-builder": "^26.18.0",
    "rolldown": "^1.3.2"
  },
  "scripts": {
    "postinstall": "node scripts/patch-electron.mjs",
    "build": "rolldown -c",
    "start": "rolldown -c && electron .",
    "package": "rolldown -c && electron-builder --config electron-builder.config.mjs --mac --win",
    "typecheck": "tsc --noEmit"
  }
}
