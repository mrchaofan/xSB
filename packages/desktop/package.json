{
  "name": "@xsb/desktop",
  "version": "1.0.1",
  "description": "The xsb desktop app: an ACP client of the hub with one window per workspace",
  "type": "module",
  "private": true,
  "main": "dist/app/main.js",
  "optionalDependencies": {
    "@volcengine/ark-cli-darwin-arm64": "1.0.65",
    "@volcengine/ark-cli-darwin-x64": "1.0.65",
    "@volcengine/ark-cli-linux-arm64": "1.0.65",
    "@volcengine/ark-cli-linux-x64": "1.0.65",
    "@volcengine/ark-cli-win32-arm64": "1.0.65",
    "@volcengine/ark-cli-win32-x64": "1.0.65"
  },
  "devDependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.107.0",
    "@agentclientprotocol/codex-acp": "^2.6.0",
    "@types/cross-spawn": "^6.0.6",
    "@xsb/hub": "1.0.1",
    "@xsb/protocol": "1.0.1",
    "cross-spawn": "^7.0.6",
    "dompurify": "^3.4.18",
    "electron": "43.8.1",
    "electron-builder": "^26.18.0",
    "marked": "^18.2.0",
    "rolldown": "^1.3.2"
  },
  "scripts": {
    "postinstall": "node scripts/patch-electron.mjs",
    "build": "rolldown -c",
    "start": "rolldown -c && electron .",
    "package": "rolldown -c && electron-builder --config electron-builder.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "test:workflow-ui": "npm run build && node test/workflow-window.cjs",
    "test:browser-native": "node test/browser-native.mjs"
  }
}
